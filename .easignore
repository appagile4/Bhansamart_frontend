# EAS Build upload ignore rules
# When this file exists, EAS CLI packages and uploads based on these rules instead of git tracking.

node_modules/
.expo/
dist/
web-build/
expo-env.d.ts

# Native folders generated by prebuild on the EAS builder
/ios
/android

# Temporary files and logs
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
*.tsbuildinfo
crash-log.txt
*.log

# Sensitive backend private keys (NEVER upload to client build)
*firebase-adminsdk*.json
service-account*.json

# Explicitly ensure critical files ARE uploaded to EAS Build
!google-services.json
!.env
