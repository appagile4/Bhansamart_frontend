{
  "cli": {
    "version": ">= 26.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://bhansamart.webstudiomatrix.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://bhansamart.webstudiomatrix.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://bhansamart.webstudiomatrix.com/api",
        "EXPO_PUBLIC_SOCKET_URL": "https://bhansamart.webstudiomatrix.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
