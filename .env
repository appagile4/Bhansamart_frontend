# =============================================================================
# BhansaMart Frontend Environment Variables (.env)
# =============================================================================
# Change your API URL here. 
#
# Examples:
# - Physical Mobile Device over Wi-Fi:   http://192.168.29.235:5000/api
# - Android Emulator (standard host):     http://10.0.2.2:5000/api
# - iOS Simulator / Local Web:            http://localhost:5000/api
# - Production Server:                    https://api.bhansamart.com/api
#
# Note: You can provide the URL with or without "/api" — the app normalizes it automatically!
# =============================================================================
EXPO_PUBLIC_API_URL=http://192.168.29.235:5000/api

# Optional: Dedicated Socket.IO URL
# (If left commented or omitted, it automatically derives the server host from EXPO_PUBLIC_API_URL!)
EXPO_PUBLIC_SOCKET_URL=http://192.168.29.235:5000

# Google Maps API Key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyBxnSInFpg3Ds3frC6HUBA9xOyBJ0ftx3U
